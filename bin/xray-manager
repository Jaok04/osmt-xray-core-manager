#!/usr/bin/env bash
# Xray Core Manager - interfaz principal.

set -Eeuo pipefail
IFS=$'\n\t'
umask 077

readonly APP_ROOT="/opt/xray-manager"

if [[ ! -d "$APP_ROOT" ]]; then
	printf 'ERROR: no existe el directorio del proyecto: %s\n' "$APP_ROOT" >&2
	exit 1
fi

# Las rutas se resuelven desde APP_ROOT en tiempo de ejecución.
# shellcheck disable=SC1091
source "$APP_ROOT/config/manager.conf"
# shellcheck disable=SC1091
source "$APP_ROOT/config/preferences.sh"
# shellcheck disable=SC1091
source "$APP_ROOT/config/paths.sh"
# shellcheck disable=SC1091
source "$APP_ROOT/config/xray-version.conf"
# shellcheck disable=SC1091
source "$APP_ROOT/lib/ui.sh"
# shellcheck disable=SC1091
source "$APP_ROOT/lib/system.sh"
# shellcheck disable=SC1091
source "$APP_ROOT/modules/connections.sh"
# shellcheck disable=SC1091
source "$APP_ROOT/modules/users.sh"
# shellcheck disable=SC1091
source "$APP_ROOT/modules/users_v2.sh"
# shellcheck disable=SC1091
source "$APP_ROOT/modules/users_v2_menu.sh"
# shellcheck disable=SC1091
source "$APP_ROOT/modules/vless_model.sh"
# shellcheck disable=SC1091
source "$APP_ROOT/modules/vless_xray_26_10_31.sh"
# shellcheck disable=SC1091
source "$APP_ROOT/modules/vless_assistant.sh"
# shellcheck disable=SC1091
source "$APP_ROOT/modules/vmess_model.sh"
# shellcheck disable=SC1091
source "$APP_ROOT/modules/vmess_xray_26_10_31.sh"
# shellcheck disable=SC1091
source "$APP_ROOT/modules/vmess_assistant.sh"
# shellcheck disable=SC1091
source "$APP_ROOT/modules/vless_backup.sh"
# shellcheck disable=SC1091
source "$APP_ROOT/modules/profiles.sh"
# shellcheck disable=SC1091
source "$APP_ROOT/modules/xray_configurations_menu.sh"
# shellcheck disable=SC1091
source "$APP_ROOT/modules/xray_admin.sh"
# shellcheck disable=SC1091
source "$APP_ROOT/modules/xray_service.sh"
# shellcheck disable=SC1091
source "$APP_ROOT/modules/system_admin.sh"
# shellcheck disable=SC1091
source "$APP_ROOT/modules/admin_settings.sh"
source "$APP_ROOT/modules/uninstall.sh"
# shellcheck disable=SC1091
source "$APP_ROOT/modules/main_menu.sh"

main() {
	menu_main
}

main "$@"